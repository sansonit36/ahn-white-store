generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  price         Int
  originalPrice Int
  image         String
  images        String   @default("[]") // JSON string of array of URLs
  description   String
  badge         String?
  savings       Int
  itemsCount    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  customerName  String
  phone         String
  email         String?  // Optional email
  city          String
  address       String
  items         String   // Stored as JSON string
  total         Int
  status        String   @default("Pending")
  paymentMethod String   @default("COD")
  date          String   // Formatting as string for compatibility with existing frontend types (e.g. "Oct 24")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  user      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Settings {
  id                Int    @id @default(1)
  facebookPixelId   String @default("")
  facebookCAPIToken String @default("")
  tiktokPixelId     String @default("")
  tiktokCAPIToken   String @default("")
  beforeImage       String @default("")
  afterImage        String @default("")
  realGlowImages    String @default("[]") // JSON string of array of URLs
  safePromiseImage  String @default("")
  ingredientsImage  String @default("")
  
  // Email Settings
  adminEmails       String @default("") // Comma separated
  smtpHost          String @default("")
  smtpPort          String @default("")
  smtpUser          String @default("")
  smtpPass          String @default("")
  smtpSecure        Boolean @default(true)
}

model Media {
  id        String   @id @default(uuid())
  type      String
  src       String
  user      String?
  createdAt DateTime @default(now())
}

model Analytics {
  date      String   @id // YYYY-MM-DD
  visitors  Int      @default(0)
  atc       Int      @default(0)
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
