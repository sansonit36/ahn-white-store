#!/usr/bin/expect

set timeout -1
set ip [lindex $argv 0]
set password [lindex $argv 1]
set script_path "./deploy.sh"

spawn $script_path root@$ip

expect {
    "Are you sure you want to continue connecting" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
    }
}

expect eof
