{% schema %}
{
  "name": "How to Use",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple Daily Routine"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "For best results, follow this simple 3-step guide."
    }
  ],
  "presets": [
    {
      "name": "How to Use"
    }
  ]
}
{% endschema %}

<section class="mb-16 md:mb-24 py-8">
  <div class="container mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-serif font-bold text-center text-gray-900 mb-4">{{ section.settings.heading }}</h2>
    <p class="text-center text-gray-500 mb-10">{{ section.settings.subheading }}</p>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      
      <!-- Step 1 -->
      <div class="bg-gray-50 rounded-2xl p-8 text-center border border-gray-100 hover:border-rose-200 transition-colors">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        </div>
        <div class="inline-block bg-rose-100 text-rose-600 text-[10px] font-bold px-2 py-1 rounded mb-3">STEP 1</div>
        <h3 class="font-bold text-gray-900 text-lg mb-2">Cleanse</h3>
        <p class="text-sm text-gray-600">Wash your face with a gentle face wash to remove oil and dust. Pat dry.</p>
      </div>

      <!-- Step 2 -->
      <div class="bg-white rounded-2xl p-8 text-center border-2 border-rose-100 shadow-lg relative transform md:-translate-y-2">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-rose-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm">
          Use Day & Night
        </div>
        <div class="w-16 h-16 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M9 5H5"/><path d="M5 19v2"/><path d="M9 19H5"/></svg>
        </div>
        <div class="inline-block bg-rose-100 text-rose-600 text-[10px] font-bold px-2 py-1 rounded mb-3">STEP 2</div>
        <h3 class="font-bold text-gray-900 text-lg mb-2">Apply AHN White+</h3>
        <p class="text-sm text-gray-600">Take a pea-sized amount and gently massage into skin until fully absorbed.</p>
      </div>

      <!-- Step 3 -->
      <div class="bg-gray-50 rounded-2xl p-8 text-center border border-gray-100 hover:border-rose-200 transition-colors">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm text-amber-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/></svg>
        </div>
        <div class="inline-block bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-1 rounded mb-3">STEP 3 (Morning)</div>
        <h3 class="font-bold text-gray-900 text-lg mb-2">Protect</h3>
        <p class="text-sm text-gray-600">Crucial: Always apply sunblock in the morning to prevent dark spots coming back.</p>
      </div>

    </div>
  </div>
</section>
