{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does it take to see results?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Most users see visible results within 3-4 weeks of consistent use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}

<section class="py-16 bg-white">
  <div class="container mx-auto px-4 max-w-3xl">
    <h2 class="text-3xl font-serif font-bold text-center text-gray-900 mb-10">{{ section.settings.heading }}</h2>
    
    <div class="space-y-4">
      {% for block in section.blocks %}
        <div x-data="{ open: false }" class="border border-gray-200 rounded-xl overflow-hidden">
          <button 
            @click="open = !open" 
            class="flex items-center justify-between w-full p-4 md:p-5 text-left bg-gray-50 hover:bg-gray-100 transition-colors"
          >
            <span class="font-bold text-gray-900">{{ block.settings.question }}</span>
            <svg 
              xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="transition-transform duration-300"
              :class="{ 'rotate-180': open }"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div 
            x-show="open" 
            x-collapse
            style="display: none;"
          >
            <div class="p-4 md:p-5 pt-0 bg-white border-t border-gray-100 text-gray-600 leading-relaxed">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
