{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

<header 
  x-data="{ 
    mobileMenuOpen: false, 
    scrolled: false 
  }" 
  @scroll.window="scrolled = (window.pageYOffset > 20)"
  :class="{ 'bg-white/95 backdrop-blur-md shadow-sm py-3': scrolled || mobileMenuOpen, 'bg-transparent py-4 text-white': !scrolled && !mobileMenuOpen }"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 text-gray-900"
>
  <div class="container mx-auto px-4 flex justify-between items-center">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group z-50 relative">
      <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-rose-300 to-amber-200 group-hover:scale-110 transition-transform duration-500"></div>
      <span class="font-serif text-2xl font-bold tracking-wide whitespace-nowrap">
        AHN <span class="bg-clip-text text-transparent bg-gradient-to-r from-amber-500 to-yellow-700">White+</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8 font-medium text-sm tracking-wide">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="hover:text-amber-500 transition-colors">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2 md:gap-4 z-50 relative">
      <a href="/account" class="p-2 text-gray-500 hover:bg-gray-100 rounded-full transition-colors hidden md:block" title="Account">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>

      <!-- Cart Trigger -->
      <button 
        @click="$dispatch('toggle-cart')" 
        class="relative p-2 hover:bg-rose-100 rounded-full transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-rose-500 transition-colors"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="absolute top-0 right-0 bg-rose-500 text-white text-[10px] w-5 h-5 flex items-center justify-center rounded-full font-bold shadow-lg animate-bounce">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </button>

      <!-- Mobile Menu Toggle -->
      <button 
        @click="mobileMenuOpen = !mobileMenuOpen" 
        class="md:hidden p-2"
      >
        <svg x-show="!mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg x-show="mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div 
    x-show="mobileMenuOpen" 
    x-transition
    class="fixed inset-0 bg-white z-40 pt-24 px-6 md:hidden"
    style="display: none;"
  >
    <nav class="flex flex-col gap-6 text-lg font-medium">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-rose-50 transition-colors">
          <span class="flex items-center gap-3">{{ link.title }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      {% endfor %}

      <div class="mt-8 border-t border-gray-100 pt-8">
        <p class="text-sm text-gray-400 uppercase tracking-widest mb-4 font-bold text-center">Contact & Support</p>
        <div class="flex justify-center gap-4 text-gray-500">
          <a href="#" class="hover:text-rose-500">Instagram</a>
          <a href="#" class="hover:text-rose-500">Facebook</a>
          <a href="#" class="hover:text-rose-500">WhatsApp</a>
        </div>
      </div>
    </nav>
  </div>
</header>
