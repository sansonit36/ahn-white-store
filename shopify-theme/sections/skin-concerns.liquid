{% schema %}
{
  "name": "Skin Concerns",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Targeted Skin Concerns"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Who is this for?"
    }
  ],
  "presets": [
    {
      "name": "Skin Concerns"
    }
  ]
}
{% endschema %}

<section class="mb-16 md:mb-24 py-16">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <span class="text-rose-500 font-bold tracking-wider text-xs md:text-sm uppercase">{{ section.settings.eyebrow }}</span>
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 mt-2">{{ section.settings.heading }}</h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      
      <!-- Sun Tan -->
      <div class="bg-amber-50 p-6 rounded-2xl text-center border border-amber-100 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-amber-500 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-1">Sun Tan</h3>
        <p class="text-xs text-gray-600">Reduces darkening caused by daily sun exposure.</p>
      </div>

      <!-- Dark Spots -->
      <div class="bg-rose-50 p-6 rounded-2xl text-center border border-rose-100 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-rose-500 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-1">Dark Spots</h3>
        <p class="text-xs text-gray-600">Fades acne marks and hyperpigmentation.</p>
      </div>

      <!-- Dullness -->
      <div class="bg-blue-50 p-6 rounded-2xl text-center border border-blue-100 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-blue-500 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-1">Dullness</h3>
        <p class="text-xs text-gray-600">Hydrates skin for a fresh, glowing look.</p>
      </div>

      <!-- Uneven Tone -->
      <div class="bg-gray-50 p-6 rounded-2xl text-center border border-gray-100 hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-4 text-gray-500 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-1">Uneven Tone</h3>
        <p class="text-xs text-gray-600">Balances discoloration for a smooth finish.</p>
      </div>

    </div>
  </div>
</section>
