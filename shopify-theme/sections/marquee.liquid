{% schema %}
{
  "name": "Image Marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Glow. Real People."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tag us to be featured! Join our growing community of radiant skin lovers."
    },
    {
      "type": "text",
      "id": "social_handle",
      "label": "Social Handle",
      "default": "@ahnwhiteplus"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Marquee"
    }
  ]
}
{% endschema %}

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>

<section class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="flex flex-col items-center mb-8 text-center px-4">
    <div class="inline-flex items-center gap-2 bg-rose-50 text-rose-600 px-3 py-1 rounded-full text-xs font-bold mb-3 border border-rose-100">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
      {{ section.settings.social_handle }}
    </div>
    <h2 class="text-2xl md:text-4xl font-serif font-bold text-gray-900">{{ section.settings.heading }}</h2>
    <p class="text-gray-500 mt-2 max-w-lg">{{ section.settings.subheading }}</p>
  </div>

  <!-- Marquee Container -->
  <div class="relative w-full overflow-hidden bg-white py-4">
    <!-- Gradient Fade Masks -->
    <div class="absolute top-0 left-0 w-8 md:w-32 h-full bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-8 md:w-32 h-full bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

    <!-- Animated Track (Tripled for seamless loop) -->
    <div class="flex w-max animate-scroll">
      {% for i in (1..3) %}
        {% for block in section.blocks %}
          <div class="shrink-0 w-64 h-80 md:w-80 md:h-[450px] mx-3 md:mx-4 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 group border border-gray-100 relative cursor-pointer">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="UGC" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
            {% else %}
               {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-100' }}
            {% endif %}
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300"></div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
