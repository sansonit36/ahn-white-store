{% schema %}
{
  "name": "Featured Bundles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Bundle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Bundles"
    }
  ]
}
{% endschema %}

<section id="shop" class="py-16 md:py-24 bg-[#FDF8F9]">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10 md:mb-16">
      <span class="text-rose-500 font-bold tracking-wider text-xs md:text-sm uppercase">Start Your Routine</span>
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-gray-900 mt-2 md:mt-3">{{ section.settings.heading }}</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8 max-w-6xl mx-auto">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: 3 %}
          {% assign is_best_value = false %}
          {% if forloop.index == 2 %}
            {% assign is_best_value = true %}
          {% endif %}

          <div class="relative bg-white rounded-3xl border {% if is_best_value %}border-amber-400 ring-4 ring-amber-50 scale-105 z-10{% else %}border-gray-200{% endif %} shadow-lg hover:shadow-xl transition-all flex flex-col">
            
            {% if is_best_value %}
              <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-amber-500 text-white px-4 py-1 md:px-6 md:py-2 rounded-full font-bold text-xs md:text-sm tracking-widest shadow-lg text-center w-max flex items-center gap-2">
                 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> 
                 MOST POPULAR
              </div>
            {% endif %}

            <div class="p-6 md:p-8 pb-0 flex-1">
              <div class="aspect-square bg-[#FDF8F9] rounded-2xl mb-6 overflow-hidden flex items-center justify-center">
                <a href="{{ product.url }}" class="w-full h-full">
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="w-full h-full object-cover mix-blend-multiply hover:scale-105 transition-transform duration-500">
                </a>
              </div>
              <a href="{{ product.url }}">
                <h3 class="text-xl md:text-2xl font-serif font-bold text-gray-900 hover:text-rose-500 transition-colors">{{ product.title }}</h3>
              </a>
              <div class="flex items-baseline gap-2 mt-2 mb-4">
                <span class="text-2xl md:text-3xl font-bold text-rose-500">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="text-base md:text-lg text-gray-400 line-through">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              
              {% if product.compare_at_price > product.price %}
                <div class="mb-4">
                  <span class="text-[10px] md:text-xs font-bold text-green-600 bg-green-100 px-2 py-1 rounded inline-block">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>
                </div>
              {% endif %}

              <div class="text-sm md:text-base text-gray-600 mb-6">{{ product.description | strip_html | truncatewords: 20 }}</div>

              <ul class="space-y-3 mb-8">
                <li class="flex items-center gap-3 text-xs md:text-sm text-gray-600">
                   <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                   Free Priority Shipping
                </li>
                <li class="flex items-center gap-3 text-xs md:text-sm text-gray-600">
                   <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
                   Sealed & Authentic
                </li>
              </ul>
            </div>

            <div class="p-6 md:p-8 pt-0 mt-auto">
              <form method="post" action="/cart/add">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button
                  type="submit"
                  class="w-full py-3 md:py-4 rounded-xl font-bold transition-all transform active:scale-95 text-sm md:text-base 
                  {% if is_best_value %}bg-amber-500 text-white hover:bg-amber-600 shadow-lg shadow-amber-200{% else %}bg-gray-900 text-white hover:bg-gray-800{% endif %}"
                >
                  ADD TO CART
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
         <div class="col-span-3 text-center py-12 text-gray-500">
            Select a collection in the theme editor to display bundles here.
         </div>
      {% endif %}
    </div>
  </div>
</section>
