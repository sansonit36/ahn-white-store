{% schema %}
{
  "name": "Vertical Videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results, Real People"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join thousands of glowing customers on TikTok & Instagram"
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (MP4/Shopify Hosted)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "user_name",
          "label": "User Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical Videos"
    }
  ]
}
{% endschema %}

<section class="py-16 bg-white overflow-hidden">
  <div class="container mx-auto px-4 mb-8">
    <h2 class="text-3xl font-serif font-bold text-center text-gray-900">{{ section.settings.heading }}</h2>
    <p class="text-center text-gray-500 mt-2">{{ section.settings.subheading }}</p>
  </div>

  <div class="flex overflow-x-auto gap-6 px-8 pb-8 snap-x scrollbar-hide">
    {% for block in section.blocks %}
      <div 
        class="snap-center shrink-0 w-[280px] h-[500px] relative rounded-2xl overflow-hidden cursor-pointer group shadow-xl bg-black"
        x-data="{ playing: false }"
        @mouseenter="$refs.video.play(); playing = true"
        @mouseleave="$refs.video.pause(); playing = false"
      >
        {% if block.settings.video %}
          {{ block.settings.video | video_tag: image_size: '600x', loop: true, muted: true, playsinline: true, class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-700', x_ref: 'video' }}
        {% else %}
          {% if block.settings.thumbnail %}
            <img 
              src="{{ block.settings.thumbnail | image_url: width: 600 }}" 
              alt="{{ block.settings.title }}" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              loading="lazy"
            >
          {% else %}
             {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-700' }}
          {% endif %}
        {% endif %}

        <div 
          class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-center justify-center pointer-events-none"
          x-show="!playing"
        >
          <div class="w-16 h-16 rounded-full bg-white/30 backdrop-blur-sm flex items-center justify-center text-white group-hover:scale-110 transition-transform">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
        </div>
        
        {% if block.settings.title != blank %}
          <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 to-transparent pointer-events-none">
            <p class="text-white font-medium">{{ block.settings.title }}</p>
          </div>
        {% endif %}

        {% if block.settings.user_name != blank %}
          <div class="absolute top-4 left-4 pointer-events-none">
            <span class="bg-black/50 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">{{ block.settings.user_name }}</span>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
