{% schema %}
{
  "name": "Authenticity Check",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Verify Your AHN Cream"
    }
  ],
  "presets": [
    {
      "name": "Authenticity Check"
    }
  ]
}
{% endschema %}

<section class="mb-16 md:mb-24 px-4 container mx-auto">
  <div class="bg-rose-50 rounded-3xl p-8 md:p-12 border border-rose-100">
    <h2 class="text-2xl md:text-3xl font-serif font-bold text-center text-gray-900 mb-8">{{ section.settings.heading }}</h2>
    <div class="grid md:grid-cols-3 gap-6">
      
      <!-- Holographic Seal -->
      <div class="bg-white p-6 rounded-2xl shadow-sm flex flex-col items-center text-center">
        <div class="w-12 h-12 bg-rose-100 rounded-full flex items-center justify-center text-rose-500 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M17.29 21.02c.12-.6.41-2.3.5-3.02"/><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M9 6.8a6 6 0 0 1 5.792 4.693"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">Holographic Seal</h3>
        <p class="text-sm text-gray-600">Ensure the outer wrap seal is intact and not tampered with.</p>
      </div>

      <!-- Batch Code -->
      <div class="bg-white p-6 rounded-2xl shadow-sm flex flex-col items-center text-center">
        <div class="w-12 h-12 bg-rose-100 rounded-full flex items-center justify-center text-rose-500 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">Batch Code</h3>
        <p class="text-sm text-gray-600">Printed on the bottom of the jar (not a sticker).</p>
      </div>

      <!-- Texture Check -->
      <div class="bg-white p-6 rounded-2xl shadow-sm flex flex-col items-center text-center">
        <div class="w-12 h-12 bg-rose-100 rounded-full flex items-center justify-center text-rose-500 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 mb-2">Texture Check</h3>
        <p class="text-sm text-gray-600">Cream should be milky white, non-greasy, and absorb quickly.</p>
      </div>

    </div>
  </div>
</section>
