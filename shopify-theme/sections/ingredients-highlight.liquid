{% schema %}
{
  "name": "Ingredients Highlight",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Inside Matters"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We know the fear of \"mix creams\". That's why we list every single ingredient."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient Name",
          "default": "Niacinamide"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Controls oil and minimizing pores."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Highlight"
    }
  ]
}
{% endschema %}

<section id="safe-promise" class="py-16 bg-[#FDF8F9]">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center gap-12 max-w-6xl mx-auto">
      <div class="flex-1">
        <span class="text-rose-500 font-bold tracking-wider text-xs md:text-sm uppercase">Transparent Formula</span>
        <h2 class="text-3xl md:text-5xl font-serif font-bold text-gray-900 mt-2 mb-6">{{ section.settings.heading }}</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          {{ section.settings.subheading }}
        </p>

        <div class="grid grid-cols-2 gap-6">
          {% for block in section.blocks %}
            <div>
              <h4 class="font-bold text-gray-900 text-lg mb-1">{{ block.settings.title }}</h4>
              <p class="text-sm text-gray-500">{{ block.settings.description }}</p>
            </div>
          {% endfor %}
        </div>

        <div class="mt-8 p-4 bg-white rounded-xl border border-rose-100 flex items-center gap-4">
           <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rose-500"><path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M17.29 21.02c.12-.6.41-2.3.5-3.02"/><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M9 6.8a6 6 0 0 1 5.792 4.693"/></svg>
          <div>
            <p class="font-bold text-gray-900">100% Original Guarantee</p>
            <p class="text-xs text-gray-500">Every box comes with a holographic seal and verifiable batch code.</p>
          </div>
        </div>
      </div>

      <div class="flex-1 relative">
        <div class="aspect-[4/5] bg-white rounded-[2rem] shadow-2xl overflow-hidden border-8 border-white">
          {% if section.settings.image %}
            <img 
              src="{{ section.settings.image | image_url: width: 800 }}" 
              alt="Safe Ingredients" 
              class="w-full h-full object-cover"
              loading="lazy"
            >
          {% else %}
             {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-200' }}
          {% endif %}
        </div>
        <div class="absolute -bottom-6 -right-6 bg-white p-6 rounded-2xl shadow-xl max-w-xs">
          <p class="font-serif italic text-gray-800 text-lg">"Finally a cream that doesn't burn my skin. The ingredient list gave me peace of mind."</p>
          <p class="text-sm font-bold text-rose-500 mt-2">- Ayesha, Lahore</p>
        </div>
      </div>
    </div>
  </div>
</section>
